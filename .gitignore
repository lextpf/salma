# Build output
build/*
!build/.gitkeep
build-*/

# Generated documentation
# docs/ is doxide + mkdocs source output
docs/*
!docs/main.html
# site/ is the mkdocs build output
site/*
!site/.gitkeep
# graphify knowledge-graph output (generated by the graphify skill)
graphify-out/
# understand-anything knowledge-graph output
/.understand-anything/

# Python
__pycache__/
__init__.py
*.pyc

# Application assets
assets/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# orphan root lockfile: there is no root package.json to own it
/package-lock.json

# React / Vite
web/dist/
web/.vite/
# Environment. Unanchored on purpose: vite.config.ts no longer sets envDir,
# so the file vite reads is web/.env, not the repo root.
.env
.env.local

# Logs
/logs/
*.log
.tmp/

# Rust
/target/

# Cutover staging DLL. deploy.bat prefers a repo-root mo2-salma.dll over
# build/bin/Release, and CUTOVER.md stages it there. Anchored so it can never
# hide a DLL elsewhere in the tree.
/mo2-salma.dll
