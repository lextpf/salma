# Build output (keep the empty dir tracked via .gitkeep)
build/*
!build/.gitkeep
build-*/

# Generated documentation
# docs/ is doxide + mkdocs source output; only the checked-in MkDocs theme override survives.
docs/*
!docs/main.html
# site/ is the mkdocs build output; keep the empty dir tracked via .gitkeep.
site/*
!site/.gitkeep
# graphify knowledge-graph output (generated by the graphify skill)
graphify-out/

# Python
__pycache__/
__init__.py
*.pyc

# Application assets
assets/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React / Vite
web/dist/
web/.vite/

# Environment - real env files stay local; .env.example is committed as the template
.env
.env.local

# Logs (runtime output only; anchored so it does not swallow web/src/comps/logs)
/logs/
*.log
.tmp/

# Rust (cargo build output)
/target/

# Golden vectors: the full-corpus generator output is large and machine-local.
# Only the curated cases under tests/golden/cases/ are committed.
/tests/golden/full/


# Cutover staging: deploy.bat prefers a repo-root mo2-salma.dll over
# build/bin/Release (deploy.bat:34-35), so CUTOVER.md stages the Rust DLL
# here. Anchored so it can never hide a DLL elsewhere in the tree.
/mo2-salma.dll
