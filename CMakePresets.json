{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake"
      }
    },
    {
      "name": "default",
      "displayName": "Release (local default)",
      "description": "release server and tests with vcpkg.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "debug server and tests with vcpkg; use Cargo for the Rust engine.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release",
      "description": "release configuration for CI.",
      "inherits": "default"
    },
    {
      "name": "ci-debug",
      "displayName": "CI Debug",
      "description": "debug configuration for CI.",
      "inherits": "debug"
    },
    {
      "name": "compile-db",
      "displayName": "compile_commands.json (Ninja sidecar)",
      "description": "generate compile_commands.json with Ninja and reuse the vcpkg cache.",
      "binaryDir": "${sourceDir}/build-cdb",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build (Release)",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Build (Debug)",
      "configuration": "Debug"
    },
    {
      "name": "tests-only",
      "configurePreset": "default",
      "displayName": "Build the salma_tests target only",
      "description": "build salma_tests; does not stage mo2-salma.dll.",
      "configuration": "Release",
      "targets": ["salma_tests"]
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "configuration": "Release"
    },
    {
      "name": "ci-tests",
      "configurePreset": "ci-release",
      "description": "build salma_tests for CI; does not stage mo2-salma.dll.",
      "configuration": "Release",
      "targets": ["salma_tests"]
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 2
      }
    }
  ]
}
