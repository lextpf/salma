# @brief provide fallback C++ flags when no compilation database exists.
# @author Alex (https://github.com/lextpf)
#
# Visual Studio does not emit `compile_commands.json`. use the `compile-db` preset for exact flags.

CompileFlags:
  Add:
    - --target=x86_64-pc-windows-msvc
    - -std=c++23
    - -I../src
    - -I../build/vcpkg_installed/x64-windows-static-md/include
    - -DWIN32
    - -D_WINDOWS
    - -D_WIN32_WINNT=0x0A00
    - -DASIO_NO_DEPRECATED
    - -DASIO_STANDALONE
